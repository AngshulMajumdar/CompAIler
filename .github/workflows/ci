name: package-and-runtime
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: sudo apt-get update && sudo apt-get install -y clang-14 lld-14 wasi-libc libclang-rt-14-dev-wasm32
      - run: python -m pip install '.[test]'
      - run: python -m pytest -q
      - run: python -m build
      - run: compailer doctor
